{
    "id": "im.bernard.Nostalgia",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "nostalgia",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules": [
        {
            "name": "nostalgia",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/bertob/nostalgia.git",
                    "tag": "0.11",
                    "commit": "563f2aaf9cf7013986f563b8f65b1e6fb6eeb7f5",
                    "x-checker-data": {
                        "type": "git",
                        "is-important": true,
                        "url": "https://gitlab.gnome.org/bertob/nostalgia.git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
